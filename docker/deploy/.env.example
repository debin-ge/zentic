# Password the daemon requires from every client, including relay clients.
# Use a long random value. Write a literal "$" as "$$".
ZENTIC_PASSWORD=change-me

# Your relay, as host:port. TLS is on by default.
RELAY_ENDPOINT=relay.example.com:443
# Set to false only for a relay without TLS, for example on a private network.
# RELAY_USE_TLS=true

# Agent CLIs installed into the image, as npm packages separated by spaces.
# AGENT_PACKAGES=@anthropic-ai/claude-code @openai/codex opencode-ai

# Host directory mounted at /workspace. Put the code the agents work on here.
# ZENTIC_WORKSPACE=./workspace

# Host loopback port for the daemon HTTP origin and bundled web UI.
# ZENTIC_HTTP_PORT=6767
